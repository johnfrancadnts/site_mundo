rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil privado da conta: apenas o próprio usuário pode ler ou alterar.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Anúncios visíveis publicamente; apenas o proprietário pode modificar os próprios anúncios.
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Avaliações visíveis publicamente, criadas por usuário autenticado, sem autoavaliação.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.targetOwnerId is string
                    && request.resource.data.targetOwnerId != request.auth.uid
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
